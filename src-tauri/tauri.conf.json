{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bragi",
  "version": "0.1",
  "identifier": "com.lin.bragi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bragi",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRkYwRTAzQUFCQjFDRUUKUldUdUhMdXFBdzcvRWRFUTZCN1ZjR0lSQS9PY0YyYklHT2Fpcm82Z2lUNXNyVFNvViswblBDS2oK",
      "endpoints": [
        "https://github.com/Lin-Barrera/Bragi/releases/latest/download/latest.json"
      ]
    }
  }
}
